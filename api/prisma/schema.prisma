generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleType {
  CAR
  MOTOR
}

model Building {
  id       String @id
  timezone String
  zones    Zone[]
}

// Price per started hour and cap per calendar day, in integer cents
model Tariff {
  id         Int    @id @default(autoincrement())
  hourlyRate Int
  dailyCap   Int
  currency   String
  zones      Zone[]
}

// What a group of spaces serves: residents (any vehicle) or visitors of one vehicle type
model Zone {
  id          Int          @id @default(autoincrement())
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id])
  isResident  Boolean
  vehicleType VehicleType?
  tariffId    Int
  tariff      Tariff       @relation(fields: [tariffId], references: [id])
  spaces      Space[]
}

model Space {
  id         Int       @id @default(autoincrement())
  buildingId String
  number     Int
  zoneId     Int
  zone       Zone      @relation(fields: [zoneId], references: [id])
  sessions   Session[]

  @@unique([buildingId, number])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  spaceId      Int
  space        Space     @relation(fields: [spaceId], references: [id])
  licensePlate String
  checkedInAt  DateTime  @default(now()) @db.Timestamptz
  checkedOutAt DateTime? @db.Timestamptz
  paidAt       DateTime? @db.Timestamptz
  payments     Payment[]
}

enum PaymentStatus {
  PAID
  FAILED
}

// One accepted call from the payment provider. paymentId is unique, so a repeated call cannot be recorded twice
model Payment {
  paymentId  String        @id
  sessionId  String        @db.Uuid
  session    Session       @relation(fields: [sessionId], references: [id])
  status     PaymentStatus
  receivedAt DateTime      @default(now()) @db.Timestamptz
}
